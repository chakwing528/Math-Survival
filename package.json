{
  "name": "math-survival",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:static": "node scripts/validate.mjs",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:smoke": "playwright test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "test:db": "supabase test db --local supabase/tests/database",
    "lint:db": "supabase db lint --local --schema public,math_survival_private --level warning --fail-on error",
    "test": "npm run check:static && npm run test:unit && npm run test:smoke"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "supabase": "2.115.0"
  }
}
